FROM qwen2.5:3b

# ==================== 用途 ====================
# 问答专用模型（spring.ai.ollama.chat.model）。
# 相对官方 qwen2.5:3b 只改了三件事：num_ctx 4096、num_gpu 36、temperature 0.7。
#
# 不要拿它做脱敏。实测 qwen 系列会把中文姓名拆成"姓 + 名"两个 token：
#   输入  王建国和李秀兰上周去了北京出差。
#   输出  [PERSON]建国和[PERSON]秀兰上周去了北京出差。
# 只替换了姓，名还露在外面 —— 属于"假脱敏"，比不替换更危险。
# 脱敏请用 Modelfile-llama3.2-3b-sanitize。
#
# 速度对比（同一句脱敏任务，实测）：
#   qwen2.5-3b   30 tok/s
#   llama3.2-3b  19 tok/s
# 问答选 qwen 是因为快 60%，不是因为脱敏效果好。

# ==================== 上下文 ====================
# RAG 一次要装：topK=5 个检索片段 + 问题 + 回答。
# 按 chunk 平均 500 token 算，5 个片段约 2500，加问答共 4096 够用。
# KV 缓存：qwen2.5 只有 2 个 KV head，约 36 KB/token，4096 约 144 MB 显存。
PARAMETER num_ctx 4096

# ==================== 显存分配（实测调优）====================
# 测试机：3 GB 显存，实测可用 2274 MiB；qwen2.5:3b 的 Q4 权重约 1930 MB，共 36 层。
#
#   num_gpu   生成速度      显存占用    GPU 占比
#     30      26.9 tok/s    1741 MB      74%
#     32      29.3 tok/s    1832 MB      78%
#     34      32.6 tok/s    1928 MB      82%
#     36      37.6 tok/s    2024 MB      87%   ← 全放，仍余 350 MB
#
# 取 36：比 30 层快 40%，显存仍然宽裕。
# 显存更小的机器往下调；加载 OOM 时先降 num_ctx 到 3072，再降 num_gpu。
PARAMETER num_gpu 36

# ==================== 内存策略 ====================
# 实测在 Ollama 0.12.x 上已无效：同为 num_gpu 时，low_vram 开或关，
# 显存占用和速度完全一致。保留只为兼容旧版本。
# 真正起作用的开关是 num_gpu。
PARAMETER low_vram false

# ==================== 生成参数 ====================
# 问答保留一点随机性，避免回答死板。
# 注意：与脱敏模型的 temperature 0 不同，这是设计如此，不是配置不一致。
# 要用这个模型做脱敏对比测试时，必须用 API 覆盖温度，否则结果不可比：
#   options: {"temperature": 0}
PARAMETER temperature 0.7

# 单次回答上限约 1000 token（约 700 汉字），防止模型跑飞
PARAMETER num_predict 1024
