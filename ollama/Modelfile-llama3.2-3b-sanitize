FROM llama3.2:3b

# ==================== 为什么单独建这个模型 ====================
# 语义脱敏专用。实测对比：
#   llama3.2-3b  "王建国和李秀兰" → "[PERSON]和[PERSON]"           ✅ 整体替换
#   qwen2.5-3b   "王建国和李秀兰" → "[PERSON]建国和[PERSON]秀兰"    ❌ 只替换姓
# 后者是"假脱敏"：看起来遮住了，实际仍能定位到人，比不替换更危险。
#
# 注意：语义脱敏默认关闭（rag.sanitize.ai-enabled=false）。
# 只有主动开启时才需要这个模型。

# ==================== 上下文 ====================
# 输入 = 提示词（约 400 token）+ 待处理片段（最大 600 token）。
# 2048 装不下最长的组合，会静默截断，所以提到 3072。
# 注意 llama3.2 有 8 个 KV head，KV 缓存约 112 KB/token，3072 约需 344 MB。
PARAMETER num_ctx 3072

# ==================== 显存 / 层数（实测调优）====================
# 测试机：3 GB 显存，空闲时实测可用 2377 MiB，共 28 层。
#
#   num_gpu   生成速度      显存占用    GPU 占比
#     14      16.4 tok/s    1316 MB      49%
#     18      19.2 tok/s    1587 MB      59%
#     20      21.7 tok/s    1727 MB      64%
#     22      23.7 tok/s    1865 MB      69%
#     24      27.3 tok/s    1998 MB      74%
#     26      31.2 tok/s    2137 MB      80%   ← 稳定档，余 240 MB
#     28      35.9 tok/s    2276 MB      85%   ← 最快，仅余 101 MB
#
# 取 28：速度是 14 层的 2.2 倍。
# 显存吃紧导致加载失败或速度骤降时改成 26，只损失 13% 速度但多 140 MB 余量。
PARAMETER num_gpu 28

# ==================== 内存策略 ====================
# 同问答模型：0.12.x 上已无效，真正起作用的开关是 num_gpu。
PARAMETER low_vram true

# ==================== 生成参数（脱敏专用）====================
# 脱敏要求"照抄不改写"，温度必须为 0
PARAMETER temperature 0

# 关掉重复惩罚：脱敏结果里会出现大量重复的 [PERSON]、[ORG]，
# 默认的 repeat_penalty 1.1 会把这些重复内容当成毛病去改写，
# 导致占位符被篡改（例如 [PERSON] 变成 [人物]），后处理就对不上了。
PARAMETER repeat_penalty 1.0

# 输出上限：输入多大输出多大，2048 足够覆盖最长片段
PARAMETER num_predict 2048
